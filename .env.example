# Copy to .env and fill locally. Never commit credentials.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
TG_BOT_TOKEN=
# Keep empty to disable Telegram until ready; demo mode never calls Telegram.
DEMO=0
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=data/community.sqlite3
# Set to 1 behind an HTTPS reverse proxy. Bind HOST=0.0.0.0 only when needed.
COOKIE_SECURE=0
